            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            position: relative;
            color: #f0e6ea;
        }
        .bg-effect {
            position: fixed;
            inset: 0;
            z-index: 0;
            background: radial-gradient(circle at 30% 40%, #2a1a24 0%, #0d080b 80%);
            overflow: hidden;
        }
        .bg-effect::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 30%, rgba(200, 80, 120, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(180, 60, 100, 0.12) 0%, transparent 40%),
                repeating-linear-gradient(45deg, rgba(180, 90, 130, 0.03) 0px, rgba(180, 90, 130, 0.03) 2px, transparent 2px, transparent 8px);
            animation: shimmer 18s linear infinite, pulseGlow 6s ease-in-out infinite alternate;
        }
        @keyframes shimmer { 0% { background-position: 0 0; } 100% { background-position: 200% 200%; } }
        @keyframes pulseGlow {
            0% { opacity: 0.6; transform: scale(1); }
            100% { opacity: 1; transform: scale(1.02); }
        }
        .floating-hearts {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: hidden;
        }
        .heart {
            position: absolute;
            color: rgba(220, 120, 160, 0.18);
            font-size: 2rem;
            animation: floatHeart 20s infinite ease-in-out;
            transform-origin: center;
        }
        .heart:nth-child(1) { left: 10%; animation-duration: 22s; font-size: 2.8rem; }
        .heart:nth-child(2) { left: 30%; animation-duration: 26s; font-size: 2rem; animation-delay: -4s; }
        .heart:nth-child(3) { left: 55%; animation-duration: 24s; font-size: 3.2rem; animation-delay: -8s; }
        .heart:nth-child(4) { left: 75%; animation-duration: 28s; font-size: 2.4rem; animation-delay: -2s; }
        .heart:nth-child(5) { left: 90%; animation-duration: 30s; font-size: 1.8rem; animation-delay: -12s; }
        .heart:nth-child(6) { left: 20%; animation-duration: 20s; font-size: 1.6rem; animation-delay: -6s; }
        .heart:nth-child(7) { left: 68%; animation-duration: 32s; font-size: 2.2rem; animation-delay: -10s; }
        .heart:nth-child(8) { left: 45%; animation-duration: 25s; font-size: 2.6rem; animation-delay: -14s; }
        .heart:nth-child(9) { left: 82%; animation-duration: 29s; font-size: 1.9rem; animation-delay: -16s; }
